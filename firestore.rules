rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidId(id) {
      return id != null && id is string && id.size() > 0 && id.size() <= 128;
    }

    // Default deny unhandled documents
    match /{document=**} {
      allow read, write: if false;
    }

    // Connection health check
    match /test/{document=**} {
      allow read, write: if true;
    }

    // Registered user accounts collection and documents
    match /registeredAccounts {
      allow read, write: if true;
    }
    match /registeredAccounts/{document=**} {
      allow read, write: if true;
    }

    // Merchant documents and all nested subcollections
    match /merchants {
      allow read, write: if true;
    }
    match /merchants/{document=**} {
      allow read, write: if true;
    }
  }
}
