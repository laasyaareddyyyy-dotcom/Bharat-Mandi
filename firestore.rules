rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidId(id) {
      return id != null && id is string && id.size() > 0 && id.size() <= 128;
    }

    // Default deny all unhandled operations
    match /{document=**} {
      allow read, write: if false;
    }

    // Connection health check
    match /test/connection {
      allow read, write: if true;
    }

    // Registered user accounts collection and documents
    match /registeredAccounts {
      allow read, write: if true;
    }
    match /registeredAccounts/{accountId} {
      allow read, write: if isValidId(accountId);
      allow delete: if false;
    }

    // Merchant documents and nested subcollections
    match /merchants {
      allow read, write: if true;
    }
    match /merchants/{merchantId} {
      allow read, write: if isValidId(merchantId);

      match /{document=**} {
        allow read, write: if isValidId(merchantId);
      }
    }
  }
}
